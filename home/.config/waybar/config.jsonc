{
  "layer": "top", // waybar at top layer
  "position": "top",
  "height": 24,
  "modules-left": [
    "niri/workspaces",
    "pulseaudio",
    "mpris"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/netblue",
    "group/cpuram",
    "group/langbatray"
  ],
  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1:web": "",
      "2:code": "",
      "3:term": "",
      "4:work": "",
      "5:music": "",
      "6:docs": "",
      "urgent": "",
      "focused": " ",
      "default": " "
    }
  },
  "niri/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    "format": "{:%d.%m.%y - %H:%M}",
    "on-click": "alacritty -e calcure"
  },
  "cpu": {
    "format": "{usage}% "
  },
  "memory": {
    "format": "{}% "
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-good": "{capacity}% {icon}", // empty format will hide the module
    "format-full": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "network": {
    //"interface": "wlan0", // (Optional) To force the use of this interface
    "format-wifi": "{bandwidthDownBits} - {bandwidthUpBits} ",
    "format-ethernet": "{bandwidthDownBits} - {bandwidthUpBits}",
    "interval": 1,
    "format-disconnected": "Disconnected ⚠",
    "tooltip": true,
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "{status}",
    "format-connected": "",
    "format-disabled": "",
    "on-click": "alacritty -e bluetui"
  },
  "pulseaudio": {
    //"scroll-step": 1,
    "format": "{volume}% {icon}  {format_source}",
    "format-muted": "",
    "format-icons": {
      "headphones": " ",
      "phone": "",
      "portable": "",
      "car": " ",
      "default": [
        "",
        " "
      ]
    },
    "on-click": "pavucontrol",
    "format-source": "󰍰",
    "format-source-muted": "󰍱"
  },
  "niri/language": {
    "format": " {}",
    "format-en": "US",
    "format-de": "DE"
  },
  "mpris": {
    "format": "{player_icon} {status_icon} <i>{artist} - {title}</i>",
    "player": "playerctld",
    "max-length": 50,
    "on-click": "playerctl play-pause",
    "format-paused": "{player_icon} {status_icon} {artist} - {title}",
    "player-icons": {
      "default": " "
    },
    "status-icons": {
      "paused": "⏸",
      "playing": "▶"
    },
    "ignored-players": [
      "firefox"
    ]
  },
  "group/netblue": {
    "orientation": "inherit",
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  "group/cpuram": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory"
    ]
  },
  "group/langbatray": {
    "orientation": "inherit",
    "modules": [
      "niri/language",
      "battery",
      "tray"
    ]
  }
}
