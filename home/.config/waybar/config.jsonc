{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar at the bottom of your screen
  "height": 24, // Waybar height
  // "width": 1366, // Waybar width
  // Choose the order of the modules
  "modules-left": ["niri/workspaces", "pulseaudio", "pulseaudio#microphone", "mpris"],
  "modules-center": ["clock"],
  "modules-right": [
    "network",
   // "bluetooth",
    "cpu",
    "memory",
    "niri/language",
    "battery",
    "tray",
  ],
  "niri/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "1:web": "",
      "2:code": "",
      "3:term": "",
      "4:work": "",
      "5:music": "",
      "6:docs": "",
      "urgent": "",
      "focused": "",
      "default": "",
    },
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
  },
  "clock": {
  "format": "{:%d.%m.%Y - %H:%M}",
  "on-click": "alacritty -e calcure"
  },
  "cpu": {
    "format": "{usage}% ",
  },
  "memory": {
    "format": "{}% ",
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-good": "{capacity}% {icon}", // An empty format will hide the module
    "format-full": "{capacity}% {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "network": {
    //"interface": "wlan0", // (Optional) To force the use of this interface
    "format-wifi": "{bandwidthDownBits} - {bandwidthUpBits} ",
    "format-ethernet": "{bandwidthDownBits} - {bandwidthUpBits}",
    "interval": 1,
    "format-disconnected": "Disconnected ⚠",
    "tooltip": true,
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "",
    "tooltip": true,
      "tooltip-format": "{status}",
    "format-connected": "",
    "format-disabled": "",
  },

  "pulseaudio": {
    "scroll-step": 1,
    "format": "{volume}% {icon}",
    "format-muted": "", 
    "format-icons": {
      "headphones": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["",""],
    },
    "on-click": "pavucontrol",
    
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍰",
    "format-source-muted": "󰍱",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip": true


  },

  "niri/language": {
    "format": "󰧺 {}",
    "format-en": "US",
    "format-de": "DE"
  },

  "mpris": {
    "format": "   {player_icon} {status_icon} <i>{artist} - {title}</i>",
    "player": "playerctld",
    "max-length": 50,
    "on-click": "playerctl play-pause",
    "format-paused": "   {player_icon} {status_icon} {artist} - {title}",
    "player-icons": {
      "default": " ",
    },
    "status-icons": {
      "paused": "⏸",
      "playing": "▶"
    }
  }

  }
}
